# Supabase project used by the gateway's admin client (server-side only; never expose to clients).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cookie-session Supabase client (lib/supabase/server.ts), used for signed-in
# user pages: login, consent, etc. These are the PUBLISHABLE/anon credentials
# — safe to ship to a browser — and are a distinct pair from
# SUPABASE_SERVICE_ROLE_KEY above. Never use the service-role key here: doing
# so would hand every visitor's browser session full database access.

# Publishable/anon key for the cookie-session client (lib/supabase/server.ts),
# which signs users in for the OAuth consent screen. Safe to expose; it is NOT
# the service-role key above. Not NEXT_PUBLIC_-prefixed on purpose: Next would
# inline that at build time, inside the Docker build, where it does not exist.
SUPABASE_ANON_KEY=

# Optional. The public origin of this gateway, e.g. https://gateway.example.com.
# When set, browser page loads on any other host (a platform host such as
# *.run.app or *.vercel.app) redirect here. MCP, OAuth and discovery endpoints
# are never redirected. Leave unset to serve every host in place.
CANONICAL_ORIGIN=
